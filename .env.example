# Memora Environment Configuration
MEMORA_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Relational Database (PostgreSQL default, SQLite fallback supported)
DATABASE_URL=postgresql+psycopg2://memora_user:memora_password@localhost:5432/memora_db
# SQLite fallback example:
# DATABASE_URL=sqlite:///./data/memora.db

# Distributed Cache
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=memora_embeddings
VECTOR_DIMENSION=1536

# Security & Policy
MEMORA_MASTER_KEY=memora_secret_dev_key_2026
DEFAULT_CONFIDENCE_THRESHOLD=0.75
