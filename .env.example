# Memora Environment Configuration
MEMORA_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
MEMORA_ALLOW_ANONYMOUS_DEV=false

# Relational Database (PostgreSQL / LibSQL Turso / SQLite fallback supported)
DATABASE_URL=sqlite:///./data/memora.db
SQLITE_FALLBACK_URL=sqlite:///./data/memora.db
USE_SQLITE_FALLBACK=true
DB_ECHO=false

# Docker Compose local PostgreSQL credentials.
# Generate a URL-safe random value, for example: openssl rand -hex 32
# Do not reuse a production password or commit the populated .env file.
POSTGRES_PASSWORD=

# Distributed Cache & Event Bus (Redis)
REDIS_URL=redis://localhost:6379/0

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=memora_embeddings
VECTOR_DIMENSION=1536

# Security & Policy
MEMORA_API_KEY=
MEMORA_MASTER_KEY=
DEFAULT_CONFIDENCE_THRESHOLD=0.75
DEFAULT_IMPORTANCE_THRESHOLD=0.50

# Service API keys (configure only the agents you deploy).
FRIDAY_API_KEY=
INFERENCE_API_KEY=
STRATEX_API_KEY=
INTELX_API_KEY=
FUTURIS_API_KEY=
CORTEX_API_KEY=
FORGE_API_KEY=
SENTINEL_API_KEY=
AI_UNIVERSE_API_KEY=

# Optional Neural Cross-Encoder Flag
MEMORA_USE_REMOTE_CROSS_ENCODER=false

# Browser origins allowed to call this API (comma-separated).
# Empty by default: this is an agent-to-agent API and server callers are
# unaffected by CORS. Credentials are only sent when you list explicit origins;
# "*" never carries credentials.
MEMORA_CORS_ORIGINS=
