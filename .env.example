# ==============================================================================
#                     MEMORA PRODUCTION CONFIGURATION
# ==============================================================================

# Core Application Settings
MEMORA_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Authoritative production relational storage: the shared private PostgreSQL instance.
# Provision a dedicated memora_db and role; never reuse another agent's database role.
DATABASE_URL=postgresql+psycopg2://memora:REPLACE_WITH_SECRET@postgres:5432/memora_db
# Local SQLite is for non-production tests/development only; production never falls back.
SQLITE_FALLBACK_URL=sqlite:///./data/memora.db
USE_SQLITE_FALLBACK=false
MEMORA_SQLITE_BUSY_TIMEOUT=30
DB_ECHO=false

# Distributed Cache & Event Bus (Redis)
REDIS_URL=redis://redis:6379/0

# Vector Database (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=memora_embeddings
VECTOR_DIMENSION=1536

# Security & Master API Key
MEMORA_API_KEY=
MEMORA_MASTER_KEY=

# CORS Whitelist (Comma-separated allowed browser origins)
MEMORA_CORS_ORIGINS=https://friday-universe.duckdns.org,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8006,http://localhost:3000

# Peer Specialist Agent API Keys (FRIDAY Universe Mesh)
FRIDAY_API_KEY=
INFERENCE_API_KEY=
STRATEX_API_KEY=
INTELX_API_KEY=
FUTURIS_API_KEY=
CORTEX_API_KEY=
FORGE_API_KEY=
SENTINEL_API_KEY=

# Policy & Retention Thresholds
DEFAULT_CONFIDENCE_THRESHOLD=0.75
DEFAULT_IMPORTANCE_THRESHOLD=0.50

# Storage Durability Authority (Oracle Cloud Always Free persistent volume)
MEMORA_SQLITE_AUTHORITATIVE=false

# Resilience & Circuit Breakers (friday_mesh peer protection)
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0
HTTP_CLIENT_TIMEOUT_SECONDS=10.0

# In-Memory Cache (Tenant-Isolated LRU / TTL)
MEMORY_CACHE_TTL_SECONDS=300.0
MEMORY_CACHE_MAX_CAPACITY=2000
